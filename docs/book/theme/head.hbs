<script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Transform fenced code blocks with language-mermaid into mermaid divs
    document.querySelectorAll('code.language-mermaid').forEach(function (code) {
      var pre = code.parentElement;
      var container = document.createElement('div');
      container.classList.add('mermaid');
      container.textContent = code.textContent;
      pre.replaceWith(container);
    });
    var theme = (document.documentElement && document.documentElement.dataset && document.documentElement.dataset.theme) || 'light';
    mermaid.initialize({ startOnLoad: true, theme: theme === 'ayu' || theme === 'coal' || theme === 'navy' ? 'dark' : 'default' });
  });
</script>
<script>
  // internals/ の統計系ページは \\( \\) と \\[ \\] で数式を書く。
  // mdbook 0.5 で mathjax-support オプションが廃止されたため、ここで MathJax を読み込む。
  window.MathJax = {
    tex: {
      inlineMath: [['\\(', '\\)']],
      displayMath: [['\\[', '\\]']]
    },
    options: {
      // コード片に現れる \\[ を数式として解釈させない。
      skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']
    }
  };
</script>
<script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
