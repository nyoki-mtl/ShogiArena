// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "shogiarena",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
	"hostRequirements": {
		"gpu": "optional"
	},
	"runArgs": [
		"--gpus",
		"all"
	],
	"features": {
		"ghcr.io/va-h/devcontainers-features/uv:1": {
			"shellautocompletion": true,
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/node:1": {
			"nodeGypDependencies": true,
			"installYarnUsingApt": true,
			"version": "lts",
			"pnpmVersion": "latest",
			"nvmVersion": "latest"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/nvidia-cuda:2": {
			"installCudnn": true,
			"installToolkit": true,
			"cudaVersion": "12.9",
			"cudnnVersion": "9.10.2.21"
		},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/workspaces/ShogiArena/.venv/bin/python",
				"search.exclude": {
					"data": true
				},
				"python.analysis.exclude": [
					"data"
				],
				"[python]": {
					"editor.formatOnSave": true,                   // 保存時にフォーマッター実行
					"editor.defaultFormatter": "charliermarsh.ruff", // Ruff拡張をフォーマッターに指定
					"editor.codeActionsOnSave": {
					  "source.fixAll": "explicit",                 // 保存時に全ての自動修正を適用
					  "source.organizeImports": "explicit"         // 保存時にインポートを整理
					}
				}
			},
			"extensions": [
				"ms-python.python",
				"charliermarsh.ruff",
				"christian-kohler.path-intellisense",
				"mechatroner.rainbow-csv"
			]
		}
	},

	// ユーザー設定
	"remoteUser": "vscode",
	"containerUser": "vscode",
	"containerEnv": {
		"CUDA_HOME": "/usr/local/cuda",
		"PATH": "/usr/local/cuda/bin:${PATH}",
		"TENSORRT_VERSION": "8.6.1.6",
		"TZ": "Asia/Tokyo"
	},
	
	// Windows ホストとの権限同期
	"updateRemoteUserUID": true,

	// chrome-devtools-mcp のポート転送
	"postStartCommand": "/bin/bash -lc \"nohup socat TCP-LISTEN:9222,fork,reuseaddr TCP:host.docker.internal:9222 >/tmp/socat-9222.log 2>&1 &\"",

	"postCreateCommand": "/bin/bash -lc \"${containerWorkspaceFolder}/.devcontainer/postCreate.sh\""
}
