# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ty/
.venv/
.env

# Build and distribution
dist/
build/
*.egg-info/

# Project directories
data/*
models/*
output/
outputs/*
.sandbox/
work_dir/
wandb/
.secrets/
site/
docs/book/build/

# Keep README files in otherwise ignored directories
!data/README.md
!models/README.md
!outputs/README.md

# Node.js & npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.eslintcache

# Archives
*.tar.gz
*.zip

# IDEs and editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.history/

# Project-specific tools
.serena/
.mcp.json
src/shogiarena/web/dashboard/static/dist/
*.mp4

# Claude Code: ignore local/runtime state, keep shared project config
.claude/*
!.claude/settings.json

# ツールが生成するサブディレクトリの CLAUDE.md は追跡しない（ルートのみ正本）
**/CLAUDE.md
!/CLAUDE.md

# Generated reports (typing audit, etc.)
agent-docs/reports/

# 参照用に置く第三者リポジトリ。公開スナップショットへ混入させない。
_refs/
shogiarena_output/
site/
examples/.runtime/
