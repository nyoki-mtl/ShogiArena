{
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.git": true,
    ".venv": true,
    "data/**": false,
    "work_dir/**": false,
    "results/**": true,
    ".benchmarks/**": true,
    "*.log": true,
    "uv.lock": true
  },
  "files.watcherExclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    ".venv/**": true,
    "data/**": true,
    "work_dir/**": true,
    "results/**": true,
    ".benchmarks/**": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.git": true,
    ".venv": true,
    "data/**": true,
    "work_dir/**": true,
    "results/**": true,
    ".benchmarks/**": true,
    "uv.lock": true
  },
  "python.analysis.extraPaths": [
    "src"
  ],
  "python.languageServer": "None",
  "cursorpyright.analysis.extraPaths": [
    "src"
  ],
  "typescript.tsdk": "node_modules/typescript/lib"
}