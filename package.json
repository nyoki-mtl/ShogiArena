{
  "type": "module",
  "scripts": {
    "frontend:lint-static": "biome lint src/shogiarena/web/dashboard/static --no-errors-on-unmatched",
    "frontend:check-static": "biome check src/shogiarena/web/dashboard/static --no-errors-on-unmatched",
    "frontend:format-static": "biome format src/shogiarena/web/dashboard/static --write --no-errors-on-unmatched",
    "frontend:check-html": "prettier --check \"src/shogiarena/web/dashboard/static/**/*.html\" --error-on-unmatched-pattern false",
    "frontend:format-html": "prettier --write \"src/shogiarena/web/dashboard/static/**/*.html\" --error-on-unmatched-pattern false",
    "frontend:dev": "vite --config src/shogiarena/web/dashboard/frontend/vite.config.ts",
    "frontend:build": "vite build --config src/shogiarena/web/dashboard/frontend/vite.config.ts",
    "frontend:preview": "vite preview --config src/shogiarena/web/dashboard/frontend/vite.config.ts",
    "frontend:test": "vitest run --config src/shogiarena/web/dashboard/frontend/vitest.config.ts",
    "frontend:typecheck": "tsc --project src/shogiarena/web/dashboard/frontend/tsconfig.typecheck.json",
    "frontend:lint": "biome lint src/shogiarena/web/dashboard/frontend/src",
    "frontend:format": "biome format src/shogiarena/web/dashboard/frontend/src --write",
    "frontend:format-all": "npm run frontend:format && npm run frontend:format-static && npm run frontend:format-html",
    "frontend:check": "npm run frontend:lint && npm run frontend:typecheck && npm run frontend:test",
    "frontend:visual": "playwright test --config visual-tests/playwright.config.ts",
    "frontend:knip": "knip --reporter compact --tsConfig src/shogiarena/web/dashboard/frontend/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.10.1",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.9.19",
    "jsdom": "^25.0.0",
    "knip": "^5.66.3",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "zod": "^3.23.8"
  },
  "dependencies": {
    "tsshogi": "2.3.1"
  }
}
